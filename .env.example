# Application
APP_NAME=ComicCraft
APP_ENV=development
HOST=127.0.0.1
PORT=8000
DEBUG=true

# AI providers: gemini or mock
LLM_PROVIDER=gemini

# Image providers: diffusers or placeholder
IMAGE_PROVIDER=diffusers

# Gemini
GEMINI_API_KEY=
GEMINI_OUTLINE_MODEL=gemini-2.5-flash
GEMINI_STORY_MODEL=gemini-2.5-pro

# Hugging Face / Diffusers
HF_TOKEN=
SD_MODEL_ID=runwayml/stable-diffusion-v1-5
TORCH_DEVICE=auto
SD_STEPS=25
SD_GUIDANCE_SCALE=7.5
IMAGE_WIDTH=512
IMAGE_HEIGHT=512

# Comic
PANEL_COUNT=5
MAX_STORY_PROMPT_LENGTH=2000
